{
	"schemaVersion": 1,
	"id": "minetale",
	"version": "${version}",
	"name": "MineTale",
	"description": "Hytale in Minecraft",
	"authors": [
		"TheCodeMonkey",
		"AnyaPizza"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/minetale/icon.png",
	"environment": "*",
	"entrypoints": {
